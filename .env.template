# InterviAI environment template — copy to `.env` and fill real values.
# NEVER commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
# Local apt PostgreSQL usually uses 5432; docker-compose.dev.yml maps 5433→5432
DB_PORT=5432
DB_NAME=interviai_dev
DB_USERNAME=interviai_user
DB_PASSWORD=change-me-strong-db-password

# ── JWT (required in production — min 256-bit secret) ─────────────────────────
JWT_SECRET=

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082
FRONTEND_URL=http://localhost:5173

# ── AI (OpenRouter — not Google Gemini direct) ────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Speech (Deepgram) — optional; browser STT used when unset ─────────────────
DEEPGRAM_API_KEY=

# ── Jobs (Apify) — optional; empty token disables live scrape ─────────────────
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2

# ── Email (optional — password reset / notifications) ─────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Frontend (Vite — bake at BUILD time) ──────────────────────────────────────
# Origin only — do NOT append /api/v1 (paths already include it)
VITE_API_BASE_URL=http://localhost:8082
VITE_APP_NAME=InterviAI
VITE_APP_VERSION=1.0.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
